# D7 local actual-model integration smoke
# Copy to .env.actual and fill only the secrets you use.

CHATBOT_MODE=actual
APP_ENV=test
MODEL_REQUEST_TIMEOUT_SECONDS=60

# Required: Basic/Consultant LLM calls
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# Optional: alternative OpenAI-compatible provider
OPENAI_BASE_URL=

# Optional: real market/trend context. Missing keys degrade to no external context.
MARKET_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=
