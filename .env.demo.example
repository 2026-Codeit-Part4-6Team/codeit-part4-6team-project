# Copy this file to /srv/team6/demo/.env on the demo VM, then fill credentials locally.
# This file contains no real secrets and must not be used for production deployment.

FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8501
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=18000
BACKEND_URL=http://backend:8000

APP_ENV=demo
CHATBOT_MODE=actual
SESSION_SECRET_KEY=replace-with-a-random-demo-secret
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_SECURE=false

DATABASE_URL=sqlite:///./data/app.db
APP_DATA_DIR=/srv/team6/demo-data

# Demo-only controls. Keep these false in production.
DEMO_PAYMENT_ENABLED=true
DEMO_ACCOUNTS_ENABLED=true
DEMO_INITIAL_CREDITS=20000
DEMO_ACCOUNT_PASSWORD=
# Optional role-specific passwords override the shared value.
# DEMO_PM_PASSWORD=
# DEMO_BASIC_PASSWORD=
# DEMO_CONSULTANT_PASSWORD=
# DEMO_SERVICE_PASSWORD=

DAILY_FREE_LIMIT=10
BASIC_CREDIT_COST=50
CONSULTANT_CREDIT_COST=10
MODEL_REQUEST_TIMEOUT_SECONDS=180
MODEL_THREAD_POOL_WORKERS=2
STALE_RECOVERY_SECONDS=240
MAX_APPROVED_IMAGE_BYTES=5242880

# Validation runtime policy.
VALIDATION_DYNAMIC_TOP_K=0
VALIDATION_TOP_K=3
VALIDATION_MAX_TOP_K=3
VALIDATION_RAG_ENABLED=1
VALIDATION_REQUIRE_LEGAL_KB=1
VALIDATION_MIN_KB_CHUNKS=30

# Actual model credentials (enter only on the VM).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.3
OPENAI_JUDGE_MODEL=
VALIDATION_JUDGE_MODEL=
HF_TOKEN=
HF_HOME=/app/.cache/huggingface
HF_HOME_HOST_PATH=/srv/team6/demo-models

# Store/trend APIs (fill only when those E2E paths are exercised).
MARKET_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=

GEOCODE_FALLBACK_ENABLED=false
GEOCODE_FALLBACK_LAT=37.4979
GEOCODE_FALLBACK_LNG=127.0276
